Algoritmo ejercicio6
	//Definimos las variables y pedimos un numero por teclado
	definir i ,num,act Como Real
	Escribir "Introduce un número por teclado :"
	leer num
	//En el bucle se mostrara las multiplicaciones del numero del 1 al 10
	Para i<-0 hasta 10 Con Paso 1 Hacer
		act<-num*i
		Escribir num," * ",i,"=",act
	FinPara
FinAlgoritmo
