Algoritmo ejercicio9
	definir i,j,result Como Real
	//creamos un bucle anidado , el primero dara el primer valor que se multiplicara por el segundo 
	para i<-1 hasta 5 con paso 1 Hacer
		para j<-0 hasta 10 con paso 1 Hacer
			result<-i*j
			escribir i," * ",j," = ",result
		FinPara
	FinPara
FinAlgoritmo
